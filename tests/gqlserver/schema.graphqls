directive @expectedType(
  """The name of the expected object or interface type."""
  name: String!
) on ARGUMENT_DEFINITION | FIELD_DEFINITION

enum Status {
  ACTIVE
  INACTIVE
  PENDING
  ARCHIVED
}

scalar Timestamp
scalar URL
scalar JSON
scalar BigInt

# Objects implementing Node have globally unique, opaque IDs of the form
# "<Type>:<key>" (e.g. "User:1", "Post:1"), so node(id:) can load any of them
# and every lookup below takes the same ID an object reports.
interface Node {
  id: ID!
}

interface Timestamped {
  createdAt: String!
}

type Query {
  hello(name: String!): String!
  users: [User!]!
  user(id: ID!): User
  # Like user, but returns null (with no error) when the user is not found.
  maybeUser(id: ID!): User
  primaryUser: User!
  secondaryUser: User!
  userName(user: ID! @expectedType(name: "User")): String!
  userNames(users: [ID!]! @expectedType(name: "User")): [String!]!
  nodeLabel(node: ID! @expectedType(name: "Node")): String!
  favoriteUserID: ID! @expectedType(name: "User")
  favoriteUserIDs: [ID!]! @expectedType(name: "User")
  favoriteNodeID: ID! @expectedType(name: "Node")
  serverInfo: ServerInfo!
  posts(authorId: ID, limit: Int): [Post!]!
  userProfile(userId: ID, includeStats: Boolean): UserProfile
  postTitles: [String!]!
  status: Status!
  now: Timestamp!
  homepage: URL!
  fetchURL(url: URL!): String!
  # Returns null (with no error) for an unknown ID.
  node(id: ID!): Node
  nodes: [Node!]!
  # Non-null interface and union fields, which are never checked for null:
  # favoriteNode is post "Post:2", featured is user "User:2".
  favoriteNode: Node!
  featured: SearchResult!
  timestamped: [Timestamped!]!
  # Additional queries for scalar coercion testing
  formatTimestamp(ts: Timestamp!): String!
  parseJSON(data: JSON!): String!
  addBigInt(a: BigInt!, b: BigInt!): BigInt!
  fetchURLNullable(url: URL): String
  fetchMultipleURLs(urls: [URL!]!): [String!]!
  search(query: String!): [SearchResult!]!
  searchConnection(query: String!): SearchResultConnection!
  usersByStatus(status: Status!): [User!]!
  sortedUsers(sort: UserSort!): [User!]!
  # Float round-trip: a Float result reused as a Float argument.
  averageRating: Float!
  echoFloat(value: Float!): Float!
}

enum UserSortField {
  NAME
  AGE
}

enum SortDirection {
  ASC
  DESC
}

input UserSort {
  field: UserSortField!
  direction: SortDirection!
}

type Mutation {
  createUser(input: CreateUserInput!): User!
  updateUser(id: ID!, input: UpdateUserInput!): User
  deleteUser(id: ID!): Boolean!
  # Returns the node with the given ID through its interface type, for
  # matching on a mutation-returned interface handle. Changes nothing.
  touchNode(id: ID!): Node!
}

type User implements Node {
  id: ID!
  name: String!
  emails: [String!]!
  age: Int
  status: Status!
  posts(first: Int, after: String, last: Int, before: String): PostConnection! @goField(forceResolver: true)
  sync: ID! @expectedType(name: "User") @goField(forceResolver: true)
  # Always returns a server-side error; used to test error reporting for a
  # field nested inside an object selection.
  alwaysFails: String! @goField(forceResolver: true)
  # Nullable object field: user "User:1" has no manager (null, no error);
  # every other user's manager is user "User:1".
  manager: User @goField(forceResolver: true)
}

type Post implements Node & Timestamped {
  id: ID!
  title: String!
  content: String!
  author: User!
  createdAt: String!
}

type PostConnection {
  posts: [Post!]!
  pageInfo: PageInfo!
}

type PageInfo {
  hasNextPage: Boolean!
  hasPreviousPage: Boolean!
  startCursor: String
  endCursor: String
}

type ServerInfo {
  version: String!
  platform: String!
  uptime: String!
  totalUsers: Int!
  totalPosts: Int!
}

type UserProfile {
  user: User!
  joinedDate: String!
  lastActivity: String!
  postCount: Int
  averagePostLength: Float
  bio: String
}

input CreateUserInput {
  name: String!
  email: String!
  age: Int
}

input UpdateUserInput {
  name: String
  email: String
  age: Int
}

directive @goField(
  forceResolver: Boolean
  name: String
  omittable: Boolean
  type: String
) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

union SearchResult = User | Post

type SearchResultEdge {
  node: SearchResult!
}

type SearchResultConnection {
  edges: [SearchResultEdge!]!
  totalCount: Int!
}

directive @customDirective(
  message: String
) on FIELD_DEFINITION

directive @experimental on FIELD_DEFINITION | OBJECT
