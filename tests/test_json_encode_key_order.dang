# JSON.encode sorts object and record keys by default, like json.Marshal
# does for Go maps. `sortKeys: false` keeps them in declaration order instead,
# like json.Marshal does for Go struct fields. Maps always keep their
# insertion order.

type Module {
  name: String!
  source: String!
  version: String @JSON.field(omitEmpty: true)
  pin: String @JSON.field(name: "pinned", omitEmpty: true)
  deps: [String!]! @JSON.field(omitEmpty: true) = []

  label: String! { name + "@" + source }
}

let mod = Module(name: "go", source: "github.com/dagger/go", pin: "abc")

assert {
  JSON.encode(mod) == """{"name":"go","pinned":"abc","source":"github.com/dagger/go"}"""
}
assert { JSON.encode(mod, sortKeys: true) == JSON.encode(mod) }

# Fields come out as the type declares them; renamed fields keep their place,
# omitted ones leave no gap, and methods never encode.
assert {
  JSON.encode(mod, sortKeys: false) == """{"name":"go","source":"github.com/dagger/go","pinned":"abc"}"""
}

# Together with the layout options, this is what Go's
# json.Encoder with SetIndent("", "  ") and SetEscapeHTML(false) writes for
# a struct.
let lock = {{
  version: 1,
  modules: [
    mod,
    Module(name: "<html>", source: "./html&css", deps: ["go"]),
  ]
}}

assert {
  JSON.encode(lock, indent: "  ", escapeHTML: false, sortKeys: false) == """
  {
    "version": 1,
    "modules": [
      {
        "name": "go",
        "source": "github.com/dagger/go",
        "pinned": "abc"
      },
      {
        "name": "<html>",
        "source": "./html&css",
        "deps": [
          "go"
        ]
      }
    ]
  }
  """
}

# Records keep their fields as written, even when one refers to a later
# sibling (fields are evaluated in dependency order).
assert {
  JSON.encode({{zed: amy + 1, amy: 1, mid: 3}}, sortKeys: false) == """{"zed":2,"amy":1,"mid":3}"""
}
assert {
  JSON.encode({{zed: amy + 1, amy: 1, mid: 3}}) == """{"amy":1,"mid":3,"zed":2}"""
}

# A selection's record has the fields in the order selected.
assert {
  JSON.encode(mod.{{source, name}}, sortKeys: false) == """{"source":"github.com/dagger/go","name":"go"}"""
}

# A decoded record follows its type, not the input.
let decoded: {{b: Int!, a: Int!}} = JSON.decode("""{"a": 1, "b": 2}""")
assert { JSON.encode(decoded, sortKeys: false) == """{"b":2,"a":1}""" }
assert { JSON.encode(decoded) == """{"a":1,"b":2}""" }

# A literal keeps the order it is written in, even where it is annotated
# with a record type that lists the fields differently.
let written: {{b: Int!, a: Int!}} = {{a: 1, b: 2}}
assert { written == decoded }
assert { JSON.encode(written, sortKeys: false) == """{"a":1,"b":2}""" }

# The order applies at every level, including objects held in maps.
let byName = ["z": {{y: 1, b: 2}}, "a": {{y: 3, b: 4}}]
assert { JSON.encode(byName) == """{"z":{"b":2,"y":1},"a":{"b":4,"y":3}}""" }
assert {
  JSON.encode(byName, sortKeys: false) == """{"z":{"y":1,"b":2},"a":{"y":3,"b":4}}"""
}

# Assigned in a different order than declared: still declaration order.
type Pair {
  second: Int!
  first: Int!

  new(first: Int!, second: Int!) {
    self.first = first
    self.second = second
    self
  }
}

assert { JSON.encode(Pair(1, 2), sortKeys: false) == """{"second":2,"first":1}""" }
