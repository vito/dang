# SPIKE: sleep and timeout (docs/proposals/concurrency-and-time.md)

# sleep pauses, then yields null
assert { sleep("1ms") == null }

# timeout yields the block's value when it finishes in time
assert { timeout("5s") { sleep("1ms"); 42 } == 42 }

# ...and null when the deadline cuts it off; the 60s sleep is cancelled, not
# waited out
assert { timeout("10ms") { sleep("60s"); 42 } == null }

# a loop that sleeps is cancelled mid-sleep
assert { timeout("10ms") { loop { sleep("1ms") } } == null }

# a loop that never sleeps is cancelled between iterations
let spins = 0
assert { timeout("10ms") { loop { spins += 1 } } == null }

# break still exits through a timeout block's enclosing loop
let ticks = 0
loop {
  ticks += 1
  if (ticks == 3) {
    break
  }
  sleep("1ms")
}
assert { ticks == 3 }

# errors raised inside the block are not mistaken for the deadline
let boom = timeout("5s") { raise "boom" } rescue { e: Error => e.message }
assert { boom == "boom" }

# invalid durations raise
let bad = sleep("soon") rescue "bad"
assert { bad == "bad" }
let negative = sleep("-1s") rescue "negative"
assert { negative == "negative" }
