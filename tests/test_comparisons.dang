# Ordering comparisons are numeric and may mix Int and Float.
assert { 1 < 2 }
assert { 2.0 > 1 }
assert { 3 <= 3 }
assert { 2.5 >= 2 }

# Ordering also works on strings, compared lexicographically.
assert { "a" < "b" }
assert { "b" > "a" }
assert { "a" <= "a" }
assert { "abc" < "abd" }
assert { ("z" < "a") == false }

# Equality compares values of related types: the same type, Int with Float
# (numerically), a subtype with its supertype. Operands of unrelated types
# are rejected (see errors/equality_unrelated_types.dang).
assert { (1 == 1) }
assert { ("a" == "a") }
assert { 1 == 1.0 }
assert { 2 != 2.5 }
