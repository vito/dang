# A possibly-null `a` (an index into `[a]!`, say) is an `a` again once it is
# known not to be null.
firstOrRaise(xs: [a]!): a {
  let r = xs[0]
  if (r == null) {
    raise "empty"
  }
  r
}

assert { firstOrRaise([1]) == 1 }
assert { firstOrRaise(["s"]) == "s" }
assert { (firstOrRaise([]) rescue "none") == "none" }

firstIfAny(xs: [a]!): a {
  let r = xs[0]
  if (r != null) { r } else { raise "empty" }
}

assert { firstIfAny([2]) == 2 }

firstAsserted(xs: [a]!): a { xs[0]! }

assert { firstAsserted([3]) == 3 }

firstNonNull(xs: [a]!): a! { xs[0]! }

assert { firstNonNull([3]) == 3 }

# with the element written non-null, indexing gives a (nullable) `a`, and
# callers' `a` is nullable
firstOfNonNull(xs: [a!]!): a { xs[0] }

assert { firstOfNonNull([4]) == 4 }
assert { firstOfNonNull([]) == null }

nonNull(x: a!): a! { x }

let three: Int! = nonNull(3)
assert { three == 3 }

# taken as a value, a function keeps that meaning
let firstRef = &firstOfNonNull
let fromRef: Int = firstRef([5])
assert { fromRef == 5 }
assert { firstRef([]) == null }
assert { [&firstOfNonNull].map { g => g([6]) } == [6] }
