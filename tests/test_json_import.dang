import Test

# The imported schema defines `scalar JSON`. The format-codec merge grafts
# encode/decode onto the imported scalar, so `Test.JSON.encode` works too, and
# unqualified `JSON` stays the builtin (an unqualified import never shadows a
# builtin). This is the real Dagger scenario.

let encoded = JSON.encode([1, 2, 3])
assert { encoded == "[1,2,3]" }

let decoded = JSON.decode("[4, 5, 6]") :: [Int!]!
assert { decoded == [4, 5, 6] }
assert { Test.JSON.encode([7]) == "[7]" }

# Unqualified, `JSON` is Dang's untyped JSON value even with the schema's JSON
# imported: decoding into it takes any value, and encoding embeds it.
let raw: JSON! = "{\"ok\":true}"
assert { JSON.encode(raw) == "{\"ok\":true}" }
let any = YAML.decode("n: 1\ns: x\no: {k: [true]}\n") :: Map[JSON!]!
assert { toString(any["s"]!) == "\"x\"" }
assert { JSON.encode(any) == "{\"n\":1,\"o\":{\"k\":[true]},\"s\":\"x\"}" }

# Its text goes to the schema's JSON through a String.
assert { parseJSON((any["o"]! :: String!) :: Test.JSON!) == "Parsed JSON: {\"k\":[true]}" }

# The schema's JSON is a JSON value too, carried on the wire as its JSON text
# in a string (Dagger's convention). Decoding into it takes any value, held
# as its text, a string with its quotes.
let schemaJSON = JSON.decode("{\"s\": \"x\", \"o\": {\"k\": 1}}") :: Map[Test.JSON!]!
assert { toString(schemaJSON["s"]!) == "\"x\"" }
assert { toString(schemaJSON["o"]!) == "{\"k\":1}" }
assert { JSON.encode(schemaJSON) == "{\"o\":{\"k\":1},\"s\":\"x\"}" }

# It is sent as the string of its text, which the server reads as JSON.
assert { parseJSON(schemaJSON["o"]!) == "Parsed JSON: {\"k\":1}" }
assert { parseJSON(schemaJSON["s"]!) == "Parsed JSON: \"x\"" }

# A result is the JSON text the server sent, formatting and all, and compares
# as the data it holds.
assert { toString(jsonConfig) == "{ \"name\": \"dang\", \"tags\": [\"a\", \"b\"], \"size\": 1.50 }" }
let config = JSON.decode(jsonConfig) :: Map[JSON!]!
assert { config.keys == ["name", "size", "tags"] }
assert { jsonConfig == "{\"size\": 1.5, \"tags\": [\"a\", \"b\"], \"name\": \"dang\"}" }
assert { JSON.encode({{config: jsonConfig}}) == "{\"config\":{\"name\":\"dang\",\"tags\":[\"a\",\"b\"],\"size\":1.50}}" }

# A round trip through the server gives the same value back.
assert { echoJSON(schemaJSON["o"]!) == schemaJSON["o"]! }
assert { echoJSON(value: "[1, null, \"two\"]") == "[1,null,\"two\"]" }

# JSON null is a value of the schema's JSON, sent as the text null, and
# distinct from no value at all.
assert { describeJSON(value: "null") == "text: null" }
assert { describeJSON(value: echoJSON(value: "null")) == "text: null" }
assert { describeJSON(value: null) == "no value" }

# Strings cast to it must be JSON, and literals are checked like the builtin's.
let fromCast: Test.JSON! = "{ \"ok\": true }"
assert { JSON.encode(fromCast) == "{\"ok\":true}" }
let notJSON = "nope"
assert { ((notJSON :: Test.JSON!) rescue null) == null }

print("JSON scalar import + codec merge tests passed!")
