import Test

# The imported schema defines `scalar JSON`, as Dagger does. It is a separate
# type, reached as `Test.JSON`; unqualified `JSON` stays the builtin import (an
# unqualified import never overrides an import's namespace), so the codec
# namespace is unaffected.

let encoded = JSON.encode([1, 2, 3])
assert { encoded == "[1,2,3]" }

let decoded = JSON.decode("[4, 5, 6]") :: [Int!]!
assert { decoded == [4, 5, 6] }

# Untyped data is Decoded, whichever format decoded it.
let any = YAML.decode("n: 1\ns: x\no: {k: [true]}\n") :: Map[Decoded!]!
assert { toString(any["s"]!) == "\"x\"" }
assert { JSON.encode(any) == "{\"n\":1,\"o\":{\"k\":[true]},\"s\":\"x\"}" }

# Data goes to the schema's JSON as JSON text.
assert { parseJSON(JSON.encode(any["o"]!) :: Test.JSON!) == "Parsed JSON: {\"k\":[true]}" }

# The schema's JSON keeps the behavior of any schema scalar, whose wire form
# Dang leaves to the server: a string stays the string, and other values are
# held as their JSON, sent back as those values.
let schemaJSON = JSON.decode("{\"s\": \"x\", \"o\": {\"k\": 1}}") :: Map[Test.JSON!]!
assert { toString(schemaJSON["s"]!) == "x" }
assert { toString(schemaJSON["o"]!) == "{\"k\":1}" }
let fromServer: Test.JSON! = "{\"ok\":true}"
assert { JSON.encode(fromServer) == "\"{\\\"ok\\\":true}\"" }

# A schema's object type has no constructor, so it is no decode target, but a
# type holding one in an optional field still decodes data without that key.
type WithInfo {
  name: String!
  info: Test.ServerInfo
}

let withInfo: WithInfo! = JSON.decode("{\"name\": \"x\"}")
assert { withInfo.name == "x" }
assert { withInfo.info == null }

print("JSON scalar import tests passed!")
