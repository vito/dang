# Canonical spelling and component access.
let version = SemVer("v1.2.3-RC.1+Build.007")
assert { version.string == "1.2.3-RC.1+Build.007" }
assert { version.major == 1 }
assert { version.minor == 2 }
assert { version.patch == 3 }
assert { version.core == "1.2.3" }
assert { version.prerelease == "RC.1" }
assert { version.build == "Build.007" }
assert { version.isPrerelease }
assert { !version.core.isPrerelease }
assert { version.core.prerelease == null }
assert { version.core.build == null }
assert { SemVer("0.0.0").core == "0.0.0" }
assert { SemVer("1.2.3+a-b.000").build == "a-b.000" }
assert { SemVer("1.2.3-alpha-beta.01a.-").prerelease == "alpha-beta.01a.-" }
assert { SemVer("1.2.3-0").prerelease == "0" }
assert { SemVer("1.2.3---+--").prerelease == "--" }

# Literal handoffs, casts, and codecs all run the same canonicalizer.
let annotated: SemVer! = "v1.2.3-RC.1+Build.007"
assert { annotated == version }
assert { version == "v1.2.3-RC.1+Build.007" }
let raw = "v1.2.3-RC.1+Build.007"
assert { (raw :: SemVer!) == version }
assert { (version :: String!) == version.string }
let degraded: String! = version
assert { degraded == version.string }
assert { toString(version) == version.string }
assert { "${version}" == version.string }

acceptVersion(candidate: SemVer! = "v1.2.3"): SemVer! { candidate }

returnedVersion: SemVer! { "v1.2.3" }

assert { acceptVersion.string == "1.2.3" }
assert { acceptVersion("v2.0.0").string == "2.0.0" }
assert { returnedVersion.string == "1.2.3" }
let literals: [SemVer!]! = ["v1.2.3", "v2.0.0"]
assert { literals.map { v => v.string } == ["1.2.3", "2.0.0"] }

scalar VersionText

let custom: VersionText! = "v1.2.3"
assert { (custom :: SemVer!).string == "1.2.3" }

type Release {
  version: SemVer!
}

let json: Release! = JSON.decode('{"version":"v1.2.3-RC.1+Build.007"}')
let yaml: Release! = YAML.decode('version: v1.2.3-RC.1+Build.007')
let toml: Release! = TOML.decode('version = "v1.2.3-RC.1+Build.007"')
assert { json.version == version }
assert { yaml.version == version }
assert { toml.version == version }
assert { JSON.encode(version) == '"1.2.3-RC.1+Build.007"' }
let decodedList: [SemVer!]! = JSON.decode('["v1.2.3", "v2.0.0"]')
assert { decodedList == literals }

# The SemVer specification's precedence chain, checked pairwise in both directions.
let chain = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0"].map { text => SemVer(text) }
chain.each { left, i =>
  chain.each { right, j =>
    let expected = if (i < j) { -1 } else if (i > j) { 1 } else { 0 }
    assert { left.compare(right) == expected }
    assert { (left.sortKey < right.sortKey) == (i < j) }
  }
}
assert { chain.reverse.sortBy { v => v.sortKey } == chain }

# Numeric precedence differs from lexical scalar ordering; ASCII case is retained.
let numeric = ["1.2.3", "1.2.10", "1.10.0", "2.0.0", "10.0.0"].map { text => SemVer(text) }
assert { numeric.reverse.sortBy { v => v.sortKey } == numeric }
assert { SemVer("1.10.0") < SemVer("1.2.0") }
assert { [SemVer("1.2.0"), SemVer("1.10.0")].sort == [SemVer("1.10.0"), SemVer("1.2.0")] }
let ascii = ["1.0.0-0", "1.0.0-9", "1.0.0-10", "1.0.0--", "1.0.0-0a", "1.0.0-A", "1.0.0-Z", "1.0.0-a", "1.0.0-a.0", "1.0.0-a-", "1.0.0-z"].map { text => SemVer(text) }
assert { ascii.reverse.sortBy { v => v.sortKey } == ascii }

# Build metadata does not influence precedence, but does influence equality.
let builds = ["1.0.0+z", "1.0.0+a", "1.0.0", "1.0.0+000"].map { text => SemVer(text) }
assert { builds.sortBy { v => v.sortKey } == builds }
assert { builds[0] != builds[1] }
builds.each { v =>
  assert { v.compare("1.0.0") == 0 }
  assert { v.sortKey == SemVer("1.0.0").sortKey }
}
assert { SemVer("1.0.0-alpha+z").compare("1.0.0-alpha+a") == 0 }
assert { SemVer("1.0.0-alpha+z") != SemVer("1.0.0-alpha+a") }

# Safe immutable edits preserve the other suffix; null removes, not empty text.
assert { version.withPrerelease("beta.2").string == "1.2.3-beta.2+Build.007" }
assert { version.withPrerelease(null).string == "1.2.3+Build.007" }
assert { version.withBuild("new.000").string == "1.2.3-RC.1+new.000" }
assert { version.withBuild(null).string == "1.2.3-RC.1" }
assert { version.withBuild(null).withPrerelease(null) == version.core }
assert { version.core.withBuild(null).withPrerelease(null) == version.core }
assert { version.core.withPrerelease("a-b").withBuild("000").string == "1.2.3-a-b+000" }
assert { version.string == "1.2.3-RC.1+Build.007" }

# Bumps increment once, reset lower components, and clear both suffixes.
assert { version.bumpMajor == "2.0.0" }
assert { version.bumpMinor == "1.3.0" }
assert { version.bumpPatch == "1.2.4" }
assert { SemVer("0.0.0").bumpMajor == "1.0.0" }
assert { SemVer("0.0.0").bumpMinor == "0.1.0" }
assert { SemVer("0.0.0").bumpPatch == "0.0.1" }
assert { SemVer("9.99.999-rc+build").bumpMajor == "10.0.0" }
assert { SemVer("9.99.999-rc+build").bumpMinor == "9.100.0" }
assert { SemVer("9.99.999-rc+build").bumpPatch == "9.99.1000" }
assert { SemVer("1.2.1099").bumpPatch == "1.2.1100" }
assert { SemVer("1.2.1200").bumpPatch == "1.2.1201" }

# Core and numeric prerelease components are unbounded even though Int getters are not.
let huge = "9999999999999999999999999999999999999999"
let bigger = "10000000000000000000000000000000000000000"
let hugeVersion = SemVer("${huge}.${huge}.${huge}-rc+build")
assert { hugeVersion.core.string == "${huge}.${huge}.${huge}" }
assert { hugeVersion.bumpMajor.string == "${bigger}.0.0" }
assert { hugeVersion.bumpMinor.string == "${huge}.${bigger}.0" }
assert { hugeVersion.bumpPatch.string == "${huge}.${huge}.${bigger}" }
assert { (hugeVersion.major rescue null) == null }
assert { (hugeVersion.minor rescue null) == null }
assert { (hugeVersion.patch rescue null) == null }
assert { hugeVersion.compare("${bigger}.0.0") == -1 }
assert { hugeVersion.compare("${huge}.${bigger}.0") == -1 }
assert { hugeVersion.compare("${huge}.${huge}.${bigger}") == -1 }
assert { SemVer("1.0.0-${huge}").compare("1.0.0-${bigger}") == -1 }
assert { SemVer("1.0.0-${huge}").compare("1.0.0-a") == -1 }
assert { SemVer("9223372036854775807.0.0").major == 9223372036854775807 }
assert { SemVer("9223372036854775807.0.0").bumpMajor == "9223372036854775808.0.0" }
assert { SemVer("1.2.123456789012345678901234567890").bumpPatch == "1.2.123456789012345678901234567891" }
assert { SemVer("123456789012345678901234567890.0.0").compare("123456789012345678901234567891.0.0") == -1 }

# Invalid syntax is recoverable at construction, cast, literal, and codec boundaries.
let invalids = ["", "v", "1", "1.2", "1.2.3.4", "vv1.2.3", "V1.2.3", " 1.2.3", "1.2.3 ", "1.2.3\n", "1.2.3\r\n", "1.2.3\t", "01.2.3", "1.02.3", "1.2.03", "-1.2.3", "+1.2.3", "1.2.3-", "1.2.3+", "1.2.3-a.", "1.2.3-.a", "1.2.3-a..b", "1.2.3+build.", "1.2.3+.build", "1.2.3+build..x", "1.2.3+build+extra", "1.2.3-01", "1.2.3-a.00", "1.2.3-a_b", "1.2.3+build_x", "1.2.3-α", "1.2.3+β", "１.2.3", "1.2.3-١", "1.2.3-a/b", "1.2.3+a/b"]
invalids.each { text =>
  assert { (SemVer(text) rescue null) == null }
  assert { ((text :: SemVer!) rescue null) == null }
  assert { ((JSON.decode(JSON.encode(text)) :: SemVer!) rescue null) == null }
}
assert { (("v01.2.3" :: SemVer!) rescue null) == null }
assert { (acceptVersion("1.2") rescue null) == null }
assert { ((JSON.decode('123') :: SemVer!) rescue null) == null }
assert { ((JSON.decode('{"version":"1.2"}') :: Release!) rescue null) == null }
assert { ((YAML.decode('version: 1.2') :: Release!) rescue null) == null }
assert { ((TOML.decode('version = "1.2"') :: Release!) rescue null) == null }

# Suffix edits must not inject another component or reinterpret malformed identifiers.
["", "01", "a.01", "alpha+evil", "a..b", "a/b", "α", "a\n"].each { pre =>
  assert { (version.withPrerelease(pre) rescue null) == null }
}
["", "a+b", ".a", "a.", "a..b", "a/b", "β", "a\n"].each { build =>
  assert { (version.withBuild(build) rescue null) == null }
}
assert { version.withBuild("01").build == "01" }
assert { version.withPrerelease("01a").prerelease == "01a" }
assert { version.withPrerelease("00a.00-").prerelease == "00a.00-" }
