# JSON encode/decode live in the JSON namespace. Encode takes an arbitrary
# value, so it cannot live on the String type (no universal receiver); decode
# materializes against an expected type supplied with `:: T`.

# Simple object literal
let obj1 = {{name: "test", value: 42}}
let json1 = JSON.encode(obj1)
assert { json1 == "{\"name\":\"test\",\"value\":42}" }

# Object literal with nested structure: fields stay in the order written
let obj2 = {{user: {{id: 1, active: true}}, count: 100}}
let json2 = JSON.encode(obj2)
assert { json2 == "{\"user\":{\"id\":1,\"active\":true},\"count\":100}" }
assert {
  JSON.encode(obj2, sortKeys: true) == "{\"count\":100,\"user\":{\"active\":true,\"id\":1}}"
}

# Empty list from filter/map should serialize as [] not null
nums: [Int] = [1, 2, 3]
let emptyFiltered = nums.filter { x => false }
assert { JSON.encode(emptyFiltered) == "[]" }

# decode materializes against the expected type
let parsed = JSON.decode("[1, 2, 3]") :: [Int!]!
assert { parsed == [1, 2, 3] }

# round-trip
let roundtrip = JSON.encode(JSON.decode("[4, 5, 6]") :: [Int!]!)
assert { roundtrip == "[4,5,6]" }

# `JSON` names two separate things: the type of untyped JSON values and the
# namespace holding encode/decode. `:: JSON` resolves the type while
# `JSON.encode` resolves the namespace's member.
let raw: JSON! = "{\"ok\":true}"
assert { JSON.encode(raw) == "{\"ok\":true}" }
let parsed2 = JSON.decode("[9, 10]") :: [Int!]!
assert { parsed2 == [9, 10] }

# The @JSON.field / @JSON.ignore directives are scoped by the type `JSON`.
type Renamed {
  fooBar: String! @JSON.field(name: "foo_bar")
}

assert { JSON.encode(Renamed("hi")) == "{\"foo_bar\":\"hi\"}" }
let back: Renamed! = JSON.decode("{\"foo_bar\":\"there\"}")
assert { back.fooBar == "there" }

print("JSON module tests passed!")
