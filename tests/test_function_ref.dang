# Function references keep zero-arity functions callable without invoking them.
#
# The state they read lives in a block: top-level functions and methods can't
# read a top-level binding that top-level statements write.
assert {
  let dynamicValue = 1

  currentValue: Int! {
    dynamicValue
  }

  let currentGetter = &currentValue
  let first = currentGetter
  dynamicValue += 1
  first == 1 and currentGetter == 2
}

# Function references can be assigned to existing function-valued fields.
assert {
  let dynamicValue = 2

  currentValue: Int! {
    dynamicValue
  }

  let storedGetter: Int! { 0 }
  storedGetter = &currentValue
  let first = storedGetter
  dynamicValue += 1
  first == 2 and storedGetter == 3
}

# Selecting a function through a receiver can also be captured without auto-call.
assert {
  type DynamicMethodRefBox {
    value: Int!

    currentValue: Int! {
      value
    }
  }

  let foo = DynamicMethodRefBox(value: 3)
  let fooGetter = &foo.currentValue
  let storedGetter: Int! { 0 }
  storedGetter = &foo.currentValue
  fooGetter == 3 and storedGetter == 3
}

print("Function ref tests passed!")
