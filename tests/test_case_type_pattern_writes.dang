type Cat { name: String! }
type Dog { name: String! }
union Pet = Cat | Dog

let count = 0
let last = ""
[Cat("a"), Dog("b"), Cat("c")].each { p =>
  case (p) {
    c: Cat => {
      count += 1
      last = c.name
    }
    d: Dog => { last = d.name }
  }
}
assert { count == 2 }
assert { last == "c" }

# The binding itself stays local to its clause.
let c = "outer"
case (Cat("inner") :: Pet!) {
  c: Cat => c.name
}
assert { c == "outer" }
