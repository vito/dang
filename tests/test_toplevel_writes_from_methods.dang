# Reassigning a top-level binding (no `let`) from inside a method, a new()
# body, a nested function, or a block inside one of those updates that binding,
# exactly like the same write from a free function. Previously such a write was
# silently re-bound as a new local of the call and vanished when it returned.
#
# NOTE: pending user approval of this semantics (vs. rejecting the write).

type Inner {
  x: Int!
}

shared: Inner! = Inner(1)
count: Int! = 0
calls: Int! = 0
built: Int! = 0

type Counter {
  value: Int! = 0

  # Bare write to a top-level binding.
  bump: Int! {
    count += 1
    count
  }

  # Field write through a top-level binding (copy-on-write on its value).
  setShared(x: Int!): Int! {
    shared.x = x
    shared.x
  }

  # From a block inside a method.
  bumpEach(xs: [Int!]!): Int! {
    xs.each { x => count += x }
    count
  }

  # From a nested function declared in a method.
  bumpNested: Int! {
    inc: Int! {
      calls += 1
      calls
    }
    inc
    inc
  }

  # A local shadowing the top-level name keeps the write local.
  shadowed: Int! {
    let count = 100
    count += 1
    count
  }

  # A field write is still a field write (copy-on-write of self).
  incr: Counter! {
    value += 1
    self
  }
}

type Tracked {
  id: Int!

  new(id: Int!) {
    built += 1
    self.id = id
    self
  }
}

freeBump: Int! {
  count += 1
  count
}

assert("method writes top-level binding") { Counter.bump == 1 and count == 1 }
assert("free function writes the same binding") { freeBump == 2 and count == 2 }

let sharedAlias = shared
assert("method field write through top-level binding") {
  Counter.setShared(50) == 50 and shared.x == 50
}
assert("alias of the old value is untouched") { sharedAlias.x == 1 }

assert("block inside a method") { Counter.bumpEach([10, 20]) == 32 and count == 32 }
assert("nested function inside a method") { Counter.bumpNested == 2 and calls == 2 }
assert("shadowing local stays local") { Counter.shadowed == 101 and count == 32 }
assert("field writes still fork self") { Counter.incr.incr.value == 2 and count == 32 }

let t1 = Tracked(1)
let t2 = Tracked(2)
assert("new() writes top-level binding") { built == 2 and t1.id == 1 and t2.id == 2 }

# Same for a private top-level `let`.
let outer = 0

type Outer {
  new {
    outer += 1
    self
  }

  bump: Int! {
    outer += 10
    outer
  }
}

assert("new() and methods write a top-level let") {
  Outer.bump == 11 and outer == 11
}
