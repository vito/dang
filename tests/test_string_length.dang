# Strings have length and isEmpty, counting characters (Unicode code points),
# not bytes.
assert { "hello".length == 5 }
assert { "".length == 0 }
assert { "héllo".length == 5 }
assert { "日本語".length == 3 }

assert { "".isEmpty }
assert { !"x".isEmpty }
assert { !" ".isEmpty }

# length and truncate measure the same characters
let s = "naïve café"
assert { s.truncate(s.length) == s }
assert { s.truncate(s.length - 1) == "naïve caf" }

# null propagates through a nullable receiver, like list methods
let none: String = null
assert { none.length == null }
assert { none.isEmpty == null }
