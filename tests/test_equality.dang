# Test equality operator edge cases

# Basic equality
let a = 42
let b = 42
let c = 43

assert { a == b }
assert { a == 42 }
assert { b == 42 }
assert { a != c }

# Comparing values of unrelated types (a number and a string) doesn't
# type-check; see errors/equality_unrelated_types.dang.

print("Equality edge case tests completed")
