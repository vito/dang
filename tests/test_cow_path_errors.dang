# Copy-on-write field writes through a nullable link. Writing through a link
# that may be null is a type error (tests/errors/assign_path_through_nullable_link.dang);
# asserting the link with `!` writes through it, and raises like any other
# assertion when it is null. (A path through a computed `{ }` member is a
# compile error: see errors/assign_through_computed_field.dang.)

type Inner {
  x: Int!
}

type Foo {
  x: Int!
  maybe: Inner = null

  bump: Foo! {
    self.maybe!.x += 1
    self
  }
}

let throughNull = {
  let a = Foo(1)
  a.maybe!.x = 4
  "unreachable"
} rescue {
  e: Error => e.message
}
assert { throughNull == "non-null assertion failed: value is null" }

# A non-null link works, and copies rather than aliasing.
let aliasing = {
  let a = Foo(1, maybe: Inner(3))
  let b = a
  a.maybe!.x = 4
  [a.maybe!.x, b.maybe!.x]
}
assert { aliasing == [4, 3] }

# Through self, and compound.
let c = Foo(1, maybe: Inner(3))
assert { c.bump.maybe!.x == 4 }
assert { c.maybe!.x == 3 }

# Asserting a nullable root.
let maybeFoo(f: Foo): Foo {
  f
}

let viaRoot(f: Foo): Int! {
  let r = maybeFoo(f)
  r!.x = 7
  r!.x
}

assert { viaRoot(Foo(1)) == 7 }
