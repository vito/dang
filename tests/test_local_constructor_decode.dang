# Local declarations need constructor signatures just like module-level types.
parseLocal(data: String!): String! {
  type Record {
    value: String!
    suffix: String! = "!"
    optional: String
  }
  let decoded: Record! = JSON.decode(data)
  assert { decoded.optional == null }
  let direct = Record(value: "direct")
  assert { direct.value == "direct" }
  decoded.value + decoded.suffix
}

assert { parseLocal("{\"value\":\"hello\"}") == "hello!" }

parseExplicit(data: String!): String! {
  type Record {
    value: String!

    new(input: String!) {
      self.value = input + "!"
      self
    }
  }
  let decoded: Record! = JSON.decode(data)
  let direct = Record(input: "direct")
  assert { direct.value == "direct!" }
  decoded.value
}

assert { parseExplicit("{\"input\":\"hello\"}") == "hello!" }

# A type declared in a block, function or type body captures nothing, so it
# decodes anywhere its values reach, outside its declaring scope too.
let made = if (true) {
  type Local {
    value: String!
  }
  Local(value: "built")
} else {
  null
}
made = JSON.decode("{\"value\": \"from a block\"}")
assert { made!.value == "from a block" }

type Outer {
  type Inner {
    value: String!
  }

  make: Inner! { Inner(value: "built") }
}

let inner = Outer.make
inner = JSON.decode("{\"value\": \"from a type body\"}")
assert { inner.value == "from a type body" }

# Decoding a type builds its fields, of whatever type.
type Holder {
  pub inner = Outer.make
}

let held: Holder! = JSON.decode("{\"inner\": {\"value\": \"held\"}}")
assert { held.inner.value == "held" }
