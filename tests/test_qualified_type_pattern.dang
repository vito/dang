# Named type patterns can be qualified (`g: Lib.Greeter! =>`), in case and
# rescue, on union, interface and decoded operands: a qualified pattern names
# its type like the same qualified type written anywhere else, so it works
# where the bare name is shadowed.
import Lib

# A local type shadows Lib's Dog; the qualified pattern still names Lib's.
type Dog {
  name: String!
}

let pet: Lib.Pet = Lib.Dog

let sound = case (pet) {
  d: Lib.Dog! => d.sound
  c: Lib.Cat! => c.sound
}

assert { sound == "woof" }

# Interface operand.
let shape: Lib.Shape = Lib.Square

let area = case (shape) {
  sq: Lib.Square! => sq.area
  else => 0
}

assert { area == 4 }

# Inline union operand.
let either = if (true) { Lib.Square } else { Lib.Greeter("x") }

let which = case (either) {
  g: Lib.Greeter! => g.greeting
  s: Lib.Square! => `square ${s.area}`
}

assert { which == "square 4" }

# Decoded operand.
let greeting = case (JSON.decode("{\"name\": \"Dang\"}")) {
  g: Lib.Greeter! => g.greeting
  else => "?"
}

assert { greeting == "Hello, Dang!" }

# Rescue.
let code = Lib.fail(7) rescue {
  e: Lib.LibError! => e.code
  else => 0
}

assert { code == 7 }

print("qualified type pattern tests passed!")
