# Decoding into a named type builds a value of exactly that type, even where
# the type's name resolves to some other binding.
import Lib

# A local type shadows the imported Greeter's unqualified name; decoding into
# the qualified Lib.Greeter must still build a Lib.Greeter.
type Greeter {
  name: Int!
}

let imported: Lib.Greeter! = JSON.decode("{\"name\": \"Dang\"}")
assert { imported.greeting == "Hello, Dang!" }

let local: Greeter! = JSON.decode("{\"name\": 42}")
assert { local.name == 42 }

type Record {
  value: String!
}

type Other {
  value: Int!
}

# A local binding named like the type does not hijack its construction.
shadowed(data: String!): String! {
  let Record = &Other
  let decoded: Record! = JSON.decode(data)
  decoded.value.toUpper
}

assert { shadowed("{\"value\": \"hi\"}") == "HI" }

# A type declared in a function body still uses that call's constructor.
localDefault(suffix: String!, data: String!): String! {
  type Tagged {
    value: String!
    tag: String! = suffix
  }
  let decoded: Tagged! = JSON.decode(data)
  decoded.value + decoded.tag
}

assert { localDefault("!", "{\"value\": \"a\"}") == "a!" }
assert { localDefault("?", "{\"value\": \"b\"}") == "b?" }

type Shadow {
  value: String!
}

# Each call decodes with its own constructor, even through a shadowed name
# and after a nested call declared the same type again.
tagAround(suffix: String!, inner: String, data: String!): String! {
  type Tagged {
    value: String!
    tag: String! = suffix
  }
  let innerResult = if (inner != null) { tagAround(inner!, null, data) } else { "" }
  decodeHere(json: String!): String! {
    let Tagged = &Shadow
    let decoded: Tagged! = JSON.decode(json)
    decoded.value + decoded.tag
  }
  innerResult + decodeHere(data)
}

assert { tagAround("!", "?", "{\"value\": \"a\"}") == "a?a!" }

# A type declared in another type's body decodes in that type's new() and
# methods, with the enclosing instance's constructor.
type Outer {
  label: String!

  type Inner {
    value: String!
  }

  new(json: String!) {
    let decoded: Inner! = JSON.decode(json)
    self.label = decoded.value
    self
  }

  relabel(json: String!): String! {
    let decoded: Inner! = JSON.decode(json)
    decoded.value
  }
}

let outer = Outer("{\"value\": \"made\"}")
assert { outer.label == "made" }
assert { outer.relabel("{\"value\": \"again\"}") == "again" }

# A field every codec ignores is never decoded, so its type need not be
# decodable here, though it is declared in another type's body.
type Maker {
  type Made {
    value: String!
  }
  make: Made! { Made(value: "made") }
}

type Wrapper {
  name: String!
  pub made @JSON.ignore @YAML.ignore @TOML.ignore = Maker.make
}

let wrapped: Wrapper! = JSON.decode("{\"name\": \"w\"}")
assert { wrapped.name == "w" }
assert { wrapped.made.value == "made" }
