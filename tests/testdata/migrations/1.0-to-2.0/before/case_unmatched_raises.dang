# In Dang 1.0, a case that matches no clause raises, so a case without
# `else` is non-null. In Dang 2.0 it yields null instead; the migration
# keeps 1.0's behaviour with an explicit raising `else`.

classify(x: Int!): String! {
  case (x) {
    0 => "zero"
    1 => "one"
  }
}

assert { classify(1) == "one" }

let unmatched = classify(9) rescue {
  e: Error => e.message
}
assert { unmatched == "no case clause matched" }
