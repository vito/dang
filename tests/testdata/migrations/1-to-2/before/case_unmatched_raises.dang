# In edition 1, a case that matches no clause raises, so a case without
# `else` is non-null. In edition 2 it yields null instead; the migration
# keeps edition 1's behaviour with an explicit raising `else`.

classify(x: Int!): String! {
  case (x) {
    0 => "zero"
    1 => "one"
  }
}

assert { classify(1) == "one" }

let unmatched = classify(9) rescue {
  e: Error => e.message
}
assert { unmatched == "no case clause matched" }
