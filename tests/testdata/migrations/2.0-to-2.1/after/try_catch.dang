# Dang 2.1 replaced try/catch with postfix `rescue`; the migration rewrites
# each try/catch to the postfix form.

boom: String! {
  raise "boom"
}

# A typed clause, with a single-form body that unwraps.
let typed = boom rescue {
  e: Error => e.message
}
assert { typed == "boom" }

# A bare catch-all binding becomes a typed catch-all on Error.
let bare = boom rescue {
  err: Error => err.message
}
assert { bare == "boom" }

# A catch-all that never reads its binding is the fallback form.
let fallback = boom rescue "fallback"
assert { fallback == "fallback" }

# A body of several forms stays a block.
let multi = {
  let x = 1
  boom
} rescue {
  e: Error => "multi"
}
assert { multi == "multi" }

# A catch without clauses re-raises every error, so it drops.
let plain = "plain"
assert { plain == "plain" }

# Clauses after a catch-all never match, so they drop.
let first = boom rescue {
  err: Error => "first"
}
assert { first == "first" }
