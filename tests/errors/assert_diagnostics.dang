# Failed assert blocks report the expression and the values of its parts:
# method receivers, comparison operands, and each operand of and/or/!
# (honoring short-circuiting). Rescued messages are printed so a single
# golden covers each shape; the final assert is left uncaught.

let report = "hello world"
let count = 3
let items = [1, 2]

print(assert { report.contains("x") } rescue {
  e: AssertionError => e.message
})

print(assert { count != 3 } rescue {
  e: AssertionError => e.message
})

print(assert { count > 5 } rescue {
  e: AssertionError => e.message
})

print(assert { items[0]! <= count - 3 } rescue {
  e: AssertionError => e.message
})

print(assert { !report.contains("hello") } rescue {
  e: AssertionError => e.message
})

print(assert { report.contains("x") and count == 2 } rescue {
  e: AssertionError => e.message
})

print(assert { report.contains("hello") and count == 2 } rescue {
  e: AssertionError => e.message
})

print(assert { report.contains("x") or count == 2 or (count > 1 and items.length == 3) } rescue {
  e: AssertionError => e.message
})

# Block-local lets can't be re-evaluated from the closure scope; a falsy `or`
# still ran every operand, so the rest are reported normally.
print(assert {
  let n = count
  n == 4 or report.contains("x")
} rescue {
  e: AssertionError => e.message
})

# ...whereas after an unavailable `and` operand there's no telling what ran.
print(assert {
  let r = report
  r.contains("x") and count == 3
} rescue {
  e: AssertionError => e.message
})

# A block-local let shadowing an outer name must not report the outer value.
print(assert {
  let count = 2
  count == 2 and report.contains("x")
} rescue {
  e: AssertionError => e.message
})

assert("report should mention x") { report.contains("x") and count == 3 }
