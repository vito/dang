# A type declared in a block gets a constructor each time the block runs, so
# decoding into it outside the block has no constructor to use, even though
# a value of it got out.
let made = if (true) {
  type Local {
    value: String!
  }
  Local(value: "built")
} else {
  null
}

made = JSON.decode("{\"value\": \"decoded\"}")
