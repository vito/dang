# A function's result may carry a `&ref` it stored, here in a method slot
# whose type says nothing about what the ref reads. Calling it from a
# declaration reads `sum` before the statement above writes it, since
# declarations run first.
let sum = 0

readSum: Int! {
  sum
}

type Box {
  get: Int! { 0 }
}

mk: Box! {
  let b = Box
  b.get = &readSum
  b
}

sum = 5
let s = mk.get
print(s)
