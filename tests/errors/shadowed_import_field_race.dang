# A local declaration shadowing an unqualified import is the top-level
# binding the initializer-write rule sees: `postTitles` may be forced from a
# {{ }} field, so its initializer can't write `total`.
import Test

let r = {{p: postTitles, q: 1}}
let postTitles = { total += 1; ["local"] }
let total = 0
print(r.p)
