# Decoding a top-level type also builds its fields, so a field whose type is
# declared in another type's body cannot be decoded outside that body.
type Outer {
  type Inner {
    value: String!
  }

  make: Inner! { Inner(value: "built") }
}

type Holder {
  pub inner = Outer.make
}

let h: Holder! = JSON.decode("{\"inner\": {\"value\": \"decoded\"}}")
