type Box {
  saved(x: Int!): Int! { x }

  store(&block(x: Int!): Int!): Box! {
    self.saved = block
    self
  }
}

type Gauge {
  level: Int! = 1

  read(x: Int!): Int! { level + x }

  let usesField = Box.store { x => level + x }
  let usesSelf = Box.store { x => self.level + x }
  let callsMethod = Box.store { x => read(x) }
  let innerBlock = Box.store { x => [x].map { y => level + y }.reduce(0) { a, b => a + b } }

  let viaNested: Box! = {
    add(x: Int!): Int! { level + x }
    Box.store { x => add(x) }
  }

  let viaArgDefault: Box! = {
    add(x: Int!, k: Int! = level): Int! { x + k }
    Box.store { x => add(x) }
  }

  let viaNestedRef: Box! = {
    add(x: Int!): Int! { level + x }
    twice(x: Int!): Int! { add(add(x)) }
    let b = Box
    b.saved = &twice
    b
  }
}
