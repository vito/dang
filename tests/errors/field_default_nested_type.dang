# Types declared in A's body capture nothing from it, so their code, methods
# included, can't use A's members: its methods, computed fields, or fields.
type A {
  level: Int! = 1
  bonus: Int!

  read(x: Int!): Int! { level + x }

  total: Int! { level + bonus }

  type B {
    n: Int! = 2

    get: Int! { read(n) }
  }

  type C {
    let sum: Int! = total
  }

  type D {
    withBonus(x: Int!): Int! { x + bonus }
  }

  new(bonus: Int!) {
    self.bonus = bonus
    self
  }
}
