# `case` on decoded data: a type pattern arm matches when the data
# materializes at its type, the first such arm wins, and `else` is required.
describe(d: Decoded!): String! {
  case (d) {
    n: Int => `int ${n}`
    s: String => `string ${s}`
    items: [Decoded!] => `list of ${items.length}`
    fields: Map[Decoded!] => `object with ${fields.keys.join(",")}`
    else => "something else"
  }
}

assert { describe(JSON.decode("42")) == "int 42" }
assert { describe(JSON.decode("\"hi\"")) == "string hi" }
assert { describe(JSON.decode("[1, 2, 3]")) == "list of 3" }
assert { describe(YAML.decode("b: 1\na: 2")) == "object with a,b" }
assert { describe(JSON.decode("true")) == "something else" }

# The first matching arm wins: 1 is an Int, and a Float too.
asFloat(d: Decoded!): String! {
  case (d) {
    f: Float => `float ${f}`
    n: Int => `int ${n}`
    else => "neither"
  }
}

assert { asFloat(JSON.decode("1")) == "float 1.0" }

# Types: an arm's type reads only the fields it declares, so an object with
# more keys still matches it; put the most specific arm first.
type Point {
  x: Int!
  y: Int!
}

type Named {
  name: String!
}

shape(d: Decoded!): String! {
  case (d) {
    p: Point => `point ${p.x},${p.y}`
    named: Named => `named ${named.name}`
    else => "unknown"
  }
}

assert { shape(JSON.decode("{\"x\": 1, \"y\": 2}")) == "point 1,2" }
assert { shape(JSON.decode("{\"name\": \"n\", \"extra\": true}")) == "named n" }
assert { shape(JSON.decode("[]")) == "unknown" }

# Strict decoding carries over: an object with keys the arm's type doesn't
# read does not match it.
assert { shape(JSON.decode("{\"x\": 1, \"y\": 2, \"z\": 3}", strict: true)) == "unknown" }

# Null data matches no type arm; a `null` arm or else takes it.
nullable(d: Decoded): String! {
  case (d) {
    null => "null"
    n: Int => `int ${n}`
    else => "other"
  }
}

assert { nullable(JSON.decode("null") :: Decoded) == "null" }
assert { nullable(JSON.decode("null") :: Decoded!) == "null" }
assert { nullable(JSON.decode("7")) == "int 7" }

# Walking nested data a level at a time.
let doc = JSON.decode("{\"modules\": [{\"name\": \"a\"}, 3]}") :: Map[Decoded!]!
let kinds = (doc["modules"]! :: [Decoded!]!).map { m =>
  case (m) {
    mod: Named => mod.name
    else => "?"
  }
}

assert { kinds == ["a", "?"] }

# A Decoded arm takes any data as it is, so it stands in for else; a
# trailing `!` on a list or map pattern is allowed and changes nothing.
listOrRest(d: Decoded!): String! {
  case (d) {
    xs: [Decoded!]! => `list ${xs.length}`
    rest: Decoded => "not a list"
  }
}

assert { listOrRest(JSON.decode("[1]")) == "list 1" }
assert { listOrRest(JSON.decode("{}")) == "not a list" }

# Null inside walked data is a Decoded! holding null: it matches no type arm
# but a Decoded one or else.
let holder = JSON.decode("{\"a\": null}") :: Map[Decoded!]!
let held = case (holder["a"]!) {
  n: Int => "int"
  else => "null data"
}

assert { held == "null data" }

print("case on Decoded tests passed!")
