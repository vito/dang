# JSON, YAML and TOML are builtin scalars of valid text in their format, and,
# as values, the namespaces holding their encode and decode.

let j = ("{\"a\": [1, 2]}" :: JSON!)
let y = ("a: [1, 2]" :: YAML!)
let t = ("a = [1, 2]" :: TOML!)

# YAML text may hold several documents.
let stream = ("a: 1\n---\nb: 2\n" :: YAML!)
assert { (stream :: String!).hasPrefix("a: 1\n---") }
assert {
  (
    (YAML.decode(stream) :: String!) rescue {
      e: Error! => e.message
    }
  ) == "YAML.decode: the text holds more than one document, but only a single document decodes"
}

# Documents holding nothing don't count: a leading or trailing `---` (as
# Kubernetes-style manifests often end) or a trailing null still decodes.
assert { (YAML.decode("a: 1\n---\n") :: Map[Int!]!)["a"] == 1 }
assert { (YAML.decode("---\na: 1\n") :: Map[Int!]!)["a"] == 1 }
assert { (YAML.decode("a: 1\n---\n~\n---\n") :: Map[Int!]!)["a"] == 1 }
assert {
  (
    toString(YAML.decode("a: 1\n---\n---\nb: 2\n") :: Map[Int!]!) rescue {
      e: Error! => e.message
    }
  ) == "YAML.decode: the text holds more than one document, but only a single document decodes"
}

# A value is its text, and degrades to String! like any scalar's.
let text: String! = j
assert { text == "{\"a\": [1, 2]}" }
assert { (y :: String!) == "a: [1, 2]" }
assert { toString(t) == "a = [1, 2]" }

# Literals coerce at a typed boundary, as to any scalar.
let emptyObject: JSON! = "{}"
assert { (emptyObject :: String!) == "{}" }

# Construction validates the text, wherever a string becomes one: a literal
# when it is checked (see tests/errors/json_scalar_invalid.dang), any other
# string when it converts.
let openBrace = "{"
let twoValues = "[1] [2]"
let openList = "a: ["
let noValue = "a ="
let lines = ["[]", "nope"]

assert {
  (
    ((openBrace :: JSON!) :: String!) rescue {
      e: Error! => e.message
    }
  ) == "invalid JSON: unexpected EOF"
}
assert {
  (
    ((twoValues :: JSON!) :: String!) rescue {
      e: Error! => e.message
    }
  ) == "invalid JSON: trailing data"
}
assert {
  (
    ((openList :: YAML!) :: String!) rescue {
      e: Error! => e.message
    }
  ).hasPrefix("invalid YAML: ")
}
assert {
  (
    ((noValue :: TOML!) :: String!) rescue {
      e: Error! => e.message
    }
  ).hasPrefix("invalid TOML: ")
}
assert {
  (
    ((lines :: [JSON!]!) :: [String!]!) rescue {
      e: Error! => [e.message]
    }
  )[0].hasPrefix("[1]: invalid JSON: ")
}

# A computed string compared with a value of the scalar converts to it, so it
# is validated then, raising if the scalar rejects it, in a comparison and a
# case pattern alike. (A literal is checked at compile time.)
let empty = ""
assert { ("[1]" :: JSON!) == `[${1}]` }
assert {
  (
    toString(j == `${empty}`) rescue {
      e: Error! => e.message
    }
  ) == "invalid JSON: EOF"
}
assert {
  (
    (
      case (j) {
        `${empty}` => "empty"
        else => "other"
      }
    ) rescue {
      e: Error! => e.message
    }
  ) == "invalid JSON: EOF"
}

# encode still returns a String!; decode takes the text, a String! or a value
# of the scalar (which degrades to it), and returns Decoded data.
let encoded: String! = JSON.encode([1, 2])
assert { encoded == "[1,2]" }
assert { (JSON.decode(j) :: Map[[Int!]!]!) == ["a": [1, 2]] }
assert { (YAML.decode(y) :: {{a: [Int!]!}}!).a == [1, 2] }
assert { (TOML.decode(t) :: {{a: [Int!]!}}!).a == [1, 2] }
assert { (JSON.decode(JSON.encode({{n: 1}}) :: JSON!) :: {{n: Int!}}!).n == 1 }

# A value of the scalar encodes as the string it is.
assert { JSON.encode(("[1]" :: JSON!)) == "\"[1]\"" }

# An explicit cast converts between custom scalars, validating at the target.
scalar Blob

let blob = (j :: Blob!)
assert { (blob :: String!) == "{\"a\": [1, 2]}" }
assert { ((blob :: JSON!) :: String!) == "{\"a\": [1, 2]}" }
assert {
  (
    ((("x" :: Blob!) :: JSON!) :: String!) rescue {
      e: Error! => e.message
    }
  ).hasPrefix("invalid JSON: ")
}
assert { (([j, j] :: [Blob!]!).length) == 2 }
assert {
  (
    ((y :: TOML!) :: String!) rescue {
      e: Error! => e.message
    }
  ).hasPrefix("invalid TOML: ")
}

# A cast converts wherever it is written, also in an unannotated field, whose
# value is inferred more than once.
type CastField {
  pub z = (("[1]" :: Blob!) :: JSON!)
}

type BadCastField {
  pub bad = (("x" :: Blob!) :: JSON!)
}

assert { CastField.z == ("[1]" :: JSON!) }
assert {
  (
    toString(BadCastField.bad) rescue {
      e: Error! => e.message
    }
  ).hasPrefix("invalid JSON: ")
}

# Values compare as scalars do: the same scalar and text.
assert { ("[1]" :: JSON!) == ("[1]" :: JSON!) }
assert { ("[1]" :: JSON!) != ("[ 1 ]" :: JSON!) }

# Each format's field directives are scoped by its scalar.
type Account {
  displayName: String! @JSON.field(name: "display_name") @YAML.field(name: "display-name")
}

assert { JSON.encode(Account("Ada")) == "{\"display_name\":\"Ada\"}" }
assert { YAML.encode(Account("Ada")) == "display-name: Ada" }

print("codec scalar tests passed!")
