# The codec namespaces (JSON, YAML, TOML) are owned by Dang and installed in
# the Prelude like Random, so encode/decode work with no schema import and no
# `scalar` declaration in scope, for all three formats alike. A schema's
# same-named scalar (Dagger defines `scalar JSON`) is a separate type; see
# tests/test_json_import.dang.

# JSON
let nums = JSON.decode("[1, 2, 3]") :: [Int!]!
assert { nums == [1, 2, 3] }
assert { JSON.encode([1, 2, 3]) == "[1,2,3]" }
let blob: JSON! = "{\"ok\":true}"
# A JSON value is JSON text, so encoding embeds it as the data it spells.
assert { JSON.encode(blob) == "{\"ok\":true}" }

# YAML (no Dagger scalar exists, yet identical behavior)
let ynums = YAML.decode("[1, 2, 3]") :: [Int!]!
assert { ynums == [1, 2, 3] }
assert { YAML.encode([1, 2, 3]) == "- 1\n- 2\n- 3" }

# TOML (top level is a table)
type Settings {
  count: Int!
  enabled: Boolean!
}

let cfg = TOML.decode("count = 3\nenabled = true") :: Settings!
assert { cfg.count == 3 }
assert { cfg.enabled == true }
assert { TOML.encode({{count: 3, enabled: true}}) == "count = 3\nenabled = true" }

print("bare codec tests passed!")
