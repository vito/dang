# The codecs (JSON, YAML, TOML) are owned by Dang and provided to every module
# as builtin imports, so encode/decode work with no schema import and no
# `scalar` declaration in scope, for all three formats alike. A schema's
# same-named scalar (Dagger defines `scalar JSON`) is a separate type; see
# tests/test_json_import.dang.

# JSON
let nums = JSON.decode("[1, 2, 3]") :: [Int!]!
assert { nums == [1, 2, 3] }
assert { JSON.encode([1, 2, 3]) == "[1,2,3]" }
let blob = JSON.decode("{\"ok\":true}") :: Decoded!
# Decoded data encodes as the data it is.
assert { JSON.encode(blob) == "{\"ok\":true}" }

# YAML (no Dagger scalar exists, yet identical behavior)
let ynums = YAML.decode("[1, 2, 3]") :: [Int!]!
assert { ynums == [1, 2, 3] }
assert { YAML.encode([1, 2, 3]) == "- 1\n- 2\n- 3" }

# TOML (top level is a table)
type Settings {
  count: Int!
  enabled: Boolean!
}

let cfg = TOML.decode("count = 3\nenabled = true") :: Settings!
assert { cfg.count == 3 }
assert { cfg.enabled == true }
assert { TOML.encode({{count: 3, enabled: true}}) == "count = 3\nenabled = true" }

# Nested tables and arrays of tables are emitted without indentation by default.
let nested = {{
  server: {{host: "localhost", tls: {{enabled: true}}}},
  users: [{{name: "Ada"}}, {{name: "Bob"}}]
}}
assert {
  TOML.encode(nested) == "[server]\nhost = \"localhost\"\n[server.tls]\nenabled = true\n\n[[users]]\nname = \"Ada\"\n\n[[users]]\nname = \"Bob\""
}
assert { TOML.encode(nested, indent: "") == TOML.encode(nested) }
assert {
  TOML.encode(nested, indent: "  ") == "[server]\n  host = \"localhost\"\n  [server.tls]\n    enabled = true\n\n[[users]]\n  name = \"Ada\"\n\n[[users]]\n  name = \"Bob\""
}
assert {
  TOML.encode(nested, indent: "\t") == "[server]\n\thost = \"localhost\"\n\t[server.tls]\n\t\tenabled = true\n\n[[users]]\n\tname = \"Ada\"\n\n[[users]]\n\tname = \"Bob\""
}

# Indentation must not comment out fields or change their names.
let commentIndent = TOML.encode(nested, indent: "#") rescue {
  e: Error! => e.message
}
assert {
  commentIndent == "TOML.encode: indent must contain only spaces and tabs, got \"#\""
}
let nameIndent = TOML.encode(nested, indent: "_") rescue {
  e: Error! => e.message
}
assert {
  nameIndent == "TOML.encode: indent must contain only spaces and tabs, got \"_\""
}

print("bare codec tests passed!")
