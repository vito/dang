# Field defaults run against the object under construction, so a closure or
# method ref created there that uses the object can't be kept (see
# tests/errors/field_default_closure_*.dang). Everything here stays allowed.

type Box {
  saved(x: Int!): Int! { x }

  store(&block(x: Int!): Int!): Box! {
    self.saved = block
    self
  }
}

double(x: Int!): Int! { x * 2 }

type Gauge {
  level: Int! = 1
  bonus: Int!

  read(x: Int!): Int! { level + x }

  # Blocks and calls a default runs right away see the object as it stands.
  let total: Int! = [1, 2].reduce(0) { acc, x => acc + x + level }
  let viaMethod: Int! = [1, 2].map { x => read(x) }.reduce(0) { a, b => a + b }
  let called: Int! = read(1)
  let calledViaSelf: Int! = self.read(2)
  let selected: Int! = self.{{level}}.level

  # Stored function values that aren't Gauge's own methods are fine.
  let f = &double
  let g = f
  let fs = [f]

  # A stored block that doesn't use the object is fine.
  let plain = Box.store { x => x + 1 }

  # Selections on another Gauge don't use the object under construction.
  let other = Box.store { x => Gauge(bonus: 0).{{level}}.level + x }

  # Closures created in a method, computed field, or new() use the finished
  # object.
  reader: Box! { Box.store { x => read(x) } }

  ref: Box! {
    let b = Box
    b.saved = &read
    b
  }

  fromNew: Box! = Box

  new(bonus: Int!) {
    self.bonus = bonus
    self.fromNew = Box.store { x => level + bonus + x }
    self
  }
}

let gauge = Gauge(bonus: 100)
assert { gauge.total == 5 }
assert { gauge.viaMethod == 5 }
assert { gauge.called == 2 and gauge.calledViaSelf == 3 }
assert { gauge.selected == 1 }
assert { gauge.g(2) == 4 and gauge.fs[0](3) == 6 }
assert { gauge.plain.saved(1) == 2 }
assert { gauge.other.saved(1) == 2 }
assert { gauge.fromNew.saved(0) == 101 }

gauge.level = 10
assert { gauge.reader.saved(1) == 11 }
assert { gauge.ref.saved(1) == 11 }

# A field holding another instance's method isn't bound to this one, so it
# can be stored like any other function value.
type Handler {
  next: Handler

  handle(x: Int!): Int! { x }

  let fallback = next.handle
  let chain = [fallback]
}

# A block default (`= { ... }`) is evaluated once, while the object is built;
# a computed field (`{ ... }`, no `=`) on every read. `dang fmt` keeps them
# apart, so this file staying formatted pins it too.
type Reading {
  n: Int! = 1

  let once: Int! = {
    let base = n
    base + 1
  }

  let each: Int! {
    let base = n
    base + 1
  }

  pair: [Int!]! { [once, each] }
}

let reading = Reading
reading.n = 10
assert { reading.pair == [2, 11] }

# Statics are immutable, so a ref to one can't go stale.
type Scale {
  self {
    base: Int! = 2
    times(x: Int!): Int! { x * base }
    let f = &times
  }
}

assert { Scale.f(3) == 6 }
