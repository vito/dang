# Test map literals and operations

# Map literal with string values
let roles = ["alice": "admin", "bob": "user"]
assert { roles["alice"] == "admin" }
assert { roles["bob"] == "user" }

# Missing key indexes to null
assert { roles["carol"] == null }

# Map literal with int values
let counts = ["a": 1, "b": 2, "c": 3]
assert { counts["b"] == 2 }

# Empty map
let empty: Map[Int!] = [:]
assert { empty.isEmpty }
assert { empty.length == 0 }

# Map equality is order-independent
assert { ["a": 1, "b": 2] == ["b": 2, "a": 1] }
assert { ["a": 1] != ["a": 2] }
assert { ["a": 1] != ["a": 1, "b": 2] }

# Map[a] is the explicit form
let annotated: Map[String!] = ["x": "y"]
assert { annotated["x"] == "y" }

# get / has
assert { counts.get("a") == 1 }
assert { counts.get("missing") == null }
assert { (counts.get("missing") ?? 10) + 1 == 11 }
assert { counts.has("a") }
assert { !counts.has("missing") }

# length / isEmpty
assert { counts.length == 3 }
assert { !counts.isEmpty }

# keys / values preserve insertion order
assert { counts.keys == ["a", "b", "c"] }
assert { counts.values == [1, 2, 3] }

# with returns a new map; original is unchanged (immutability)
let extended = counts.with("d", 4)
assert { extended.length == 4 }
assert { extended["d"] == 4 }
assert { counts.length == 3 }
assert { counts.get("d") == null }

# with replaces an existing key in place (keeps position)
let replaced = counts.with("b", 20)
assert { replaced["b"] == 20 }
assert { replaced.keys == ["a", "b", "c"] }

# without returns a new map; original is unchanged
let removed = counts.without("a")
assert { removed == ["b": 2, "c": 3] }
assert { counts.length == 3 }

# without a missing key is a no-op
assert { counts.without("zzz") == counts }

# merge: other wins on conflicts
let merged = counts.merge(["c": 30, "e": 5])
assert { merged == ["a": 1, "b": 2, "c": 30, "e": 5] }
assert { counts["c"] == 3 }

# map transforms values, preserves keys
let doubled = counts.map { key, value => value * 2 }
assert { doubled == ["a": 2, "b": 4, "c": 6] }

# map can change the value type
let labeled = counts.map { key, value => `${key}=${value}` }
assert { labeled["a"] == "a=1" }

# reduce accumulates values in insertion order
let total = counts.reduce(0) { sum, key, value => sum + value }
assert { total == 6 }

let reducedKeys = counts.reduce("") { keys, key, value => keys + key }
assert { reducedKeys == "abc" }

# reduce on an empty map returns the initial value
assert { empty.reduce(42) { sum, key, value => sum + value } == 42 }

# each iterates in insertion order and returns the original map
let seen: List[String!] = []
counts.each { key, value => seen = seen + [key] }
assert { seen == ["a", "b", "c"] }

# dynamic (non-literal) keys
let k = "dynamic"
let dyn = [k: 42]
assert { dyn["dynamic"] == 42 }

# decoding into Map[T]: values materialize at T, keys come back sorted
let decoded: Map[Int!]! = JSON.decode("""{"z": 1, "a": 2}""")
assert { decoded == ["a": 2, "z": 1] }
assert { decoded.keys == ["a", "z"] }
assert { JSON.encode(decoded) == """{"a":2,"z":1}""" }

let emptyDecoded: Map[Int!]! = JSON.decode("{}")
assert { emptyDecoded.isEmpty }

let nullDecoded: Map[Int!] = JSON.decode("null")
assert { nullDecoded == null }

enum MapStatus { UP DOWN }
let statuses = JSON.decode("""{"web": "UP", "db": "DOWN"}""") :: Map[MapStatus!]!
assert { statuses["web"] == MapStatus.UP }
assert { statuses["db"] == MapStatus.DOWN }

let nested: Map[Map[String]!]! = JSON.decode("""{"o": {"k": null, "j": "v"}}""")
assert { nested["o"] == ["j": "v", "k": null] }

let yamlDecoded = YAML.decode("b: [1, 2]\na: []") :: Map[[Int!]!]!
assert { yamlDecoded == ["a": [], "b": [1, 2]] }

type MapItem {
  name: String!
  n: Int! = 1
}

let tomlDecoded: Map[MapItem!]! = TOML.decode("[x]\nname = \"one\"\n[y]\nname = \"two\"\nn = 5")
assert { tomlDecoded.map { key, item => item.n } == ["x": 1, "y": 5] }
assert { tomlDecoded["y"].name == "two" }

type MapConfig {
  env: Map[String!]! = [:]
}

let config: MapConfig! = JSON.decode("""{"env": {"FOO": "bar"}}""")
assert { config.env == ["FOO": "bar"] }
let defaulted: MapConfig! = JSON.decode("{}")
assert { defaulted.env.isEmpty }

# map literals holding decoded values materialize at the expected value type
let literalOfDecoded = ["a": JSON.decode("1")] :: Map[Int!]!
assert { literalOfDecoded["a"] + 1 == 2 }

# decode errors name the offending key
let wrongValue = (JSON.decode("""{"a": "x"}""") :: Map[Int!]!) rescue {
  err: Error => err.message
}
assert { wrongValue == """["a"]: expected int, got string""" }
let notObject = (JSON.decode("[1]") :: Map[Int!]!) rescue {
  err: Error => err.message
}
assert { notObject == "expected object, got array" }
let nestedNull = (JSON.decode("""{"a": {"b c": null}}""") :: Map[Map[Int!]!]!) rescue {
  err: Error => err.message
}
assert { nestedNull == """["a"]["b c"]: null is not allowed for Int!""" }
