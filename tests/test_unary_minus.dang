assert { -5 == 0 - 5 }
assert { -3.5 == 0.0 - 3.5 }
assert { -(1 + 2) == -3 }
assert { 10 + -3 == 7 }
assert { 10 - -3 == 13 }
assert { -(-5) == 5 }

let a = 7
assert { -a == -7 }
assert { -(-a) == 7 }

let b = -4
assert { -b == 4 }

assert { [-1, -2, -3][0] == -1 }
assert { [-1, -2, -3][2] == -3 }

# The Int bounds: 9223372036854775807 is the largest literal, and the minimum
# is written as an expression since `-` isn't part of the literal.
let maxInt = 9223372036854775807
let minInt = -9223372036854775807 - 1
assert { -maxInt - 1 == minInt }
assert { minInt + maxInt == -1 }
