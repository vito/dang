# Test non-null lazy inline fragment

type Cat {
  name: String!
  lives: Int! = 9
}

type Dog {
  name: String!
  tricks: Int! = 3
}

union Pet = Cat | Dog

cat: Pet! = Cat(name: "Whiskers")

# Non-null type assertion that matches
narrowed: Cat! = cat.{{... on Cat!}}
assert { narrowed.name == "Whiskers" }
assert { narrowed.lives == 9 }

# The non-null form asserts the value is non-null too
noPet: Pet = null
let asserted = { noPet.{{... on Cat!}}.name } rescue {
  e: RuntimeError => e.message
}
assert { asserted == "inline fragment type assertion failed: expected one of Cat, got null" }
assert { noPet.{{... on Cat}} == null }

print("Non-null lazy inline fragment tests passed!")
