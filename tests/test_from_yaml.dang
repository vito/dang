enum Status { PASSED FAILED }
scalar CustomScalar

type Child {
  name: String!
  outcome: Status!
}

type Summary {
  children: [Child!]!
  optional: String
  withDefault: String! = "default"
}

echoStatus(status: Status!): Status! { status }

parseSummary(data: String!): Summary! { YAML.decode(data) }

let status1 = YAML.decode("PASSED") :: Status!
assert { status1 == Status.PASSED }

let status2: Status! = YAML.decode("FAILED")
assert { status2 == Status.FAILED }

let status3 = echoStatus(YAML.decode("PASSED"))
assert { status3 == Status.PASSED }

let scalar: CustomScalar! = YAML.decode("hello")
assert { scalar == "hello" }

let summary: Summary! = YAML.decode(```yaml
children:
  - name: one
    outcome: PASSED
    ignored: true
  - name: two
    outcome: FAILED
```)

assert { summary.children.length == 2 }
assert { summary.children[0].name == "one" }
assert { summary.children[0].outcome == Status.PASSED }
assert { summary.children[1].outcome == Status.FAILED }
assert { summary.optional == null }
assert { summary.withDefault == "default" }

let parsed = parseSummary(```yaml
children:
  - name: three
    outcome: PASSED
```)
assert { parsed.children[0].name == "three" }
assert { parsed.children[0].outcome == Status.PASSED }

let anon = YAML.decode(```yaml
foo: 1
bar: PASSED
extra: 2
```) :: {{foo: Int!, bar: Status!}}!
assert { anon.foo == 1 }
assert { anon.bar == Status.PASSED }

# `<<` merge keys: the mapping's own keys win wherever they appear, and in a
# merge sequence earlier mappings win over later ones
type Service {
  image: String!
  port: Int! = 80
  replicas: Int! = 1
}

let services = YAML.decode(```yaml
base: &base
  image: nginx
  port: 8080
scaled: &scaled
  image: redis
  port: 9000
  replicas: 3
web:
  port: 1
  <<: *base
api:
  <<: [*base, *scaled]
inline:
  <<: {image: busybox}
```) :: Map[Service!]!
assert { services["web"].image == "nginx" }
assert { services["web"].port == 1 }
assert { services["api"].image == "nginx" }
assert { services["api"].port == 8080 }
assert { services["api"].replicas == 3 }
assert { services["inline"].image == "busybox" }
assert { services["inline"].port == 80 }

# merging into a record works the same way
let merged = YAML.decode("defaults: &d\n  image: alpine\nsvc:\n  <<: *d\n  replicas: 2") :: {{svc: Service!}}!
assert { merged.svc.image == "alpine" }
assert { merged.svc.replicas == 2 }

# a quoted "<<" is an ordinary key
let quotedMerge = YAML.decode("\"<<\": 1") :: Map[Int!]!
assert { quotedMerge == ["<<": 1] }

# YAML.encode quotes a "<<" key so it round-trips instead of reading back as a
# merge key
assert { YAML.encode(["<<": 1, "a": 2]) == "\"<<\": 1\na: 2" }
let roundTripped = YAML.decode(YAML.encode(["<<": ["<<": 3]])) :: Map[Map[Int!]!]!
assert { roundTripped == ["<<": ["<<": 3]] }

let badMerge = (YAML.decode("a:\n  <<: 5") :: Map[Map[Int!]!]!) rescue {
  err: Error => err.message
}
assert { badMerge == "YAML.decode: invalid YAML: a: <<: merge value must be a mapping or a sequence of mappings" }
