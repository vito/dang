# Tests for toString helper: a string is its own text; anything else is the
# Dang literal it would be written as, the same rendering List.join, string
# interpolation and print use.

# String input returns as-is
let str = "hello"
let result1 = toString(str)
assert { result1 == "hello" }

# Numbers and booleans are their literals
let num = 42
let result2 = toString(num)
assert { result2 == "42" }

let bool = true
let result3 = toString(bool)
assert { result3 == "true" }

# A list is a list literal, its strings quoted
let list = [1, 2, 3]
let result4 = toString(list)
assert { result4 == "[1, 2, 3]" }
assert { toString(["a", "b"]) == "[\"a\", \"b\"]" }

# A record is a record literal, fields as written
let obj = {{a: 1, b: "test"}}
let result5 = toString(obj)
assert { result5 == "{{a: 1, b: \"test\"}}" }

# A map is a map literal
assert { toString(["k": [1]]) == "[\"k\": [1]]" }

# Null is null
let result6 = toString(null)
assert { result6 == "null" }

# Enum values render as their bare name; nested, as the enum literal
enum Color { RED GREEN BLUE }
let result7 = toString(Color.RED)
assert { result7 == "RED" }
assert { toString([Color.RED]) == "[Color.RED]" }

# Floats read back as floats
assert { toString(1234567.5) == "1234567.5" }
assert { toString([1.0, 2.5]) == "[1.0, 2.5]" }
assert { `${0.0000001}` == "1e-07" }

# An object shows its public data fields, not its methods or private (`let`)
# fields, and a namespace shows by name
type Doubler {
  a: Int! = 1
  let secret: String! = "hidden"

  twice: Int! { a * 2 }
}

assert { toString(Doubler) == "{{a: 1}}" }
assert { `${Doubler}` == "{{a: 1}}" }
assert { [Doubler].join(" ") == "{{a: 1}}" }
assert { toString(JSON) == "module JSON" }

# Records are data: literals, selections and decoded records show every field
assert { toString(Doubler.{{a}}) == "{{a: 1}}" }
assert { toString(JSON.decode("{\"x\": 1}") :: {{x: Int!}}!) == "{{x: 1}}" }

# Inline-fragment selections are records too
type Left {
  x: Int! = 1
}

type Right {
  y: Int! = 2
}

union Side = Left | Right

let sides: [Side!]! = [Left, Right]
assert { toString(sides.{{... on Left {{ x }}, ... on Right {{ y }}}}) == "[{{x: 1}}, {{y: 2}}]" }

# An object whose data is all private shows no fields
type Sealed {
  let n: Int! = 5
}

assert { toString(Sealed) == "{{}}" }

# Interpolation, join and toString agree
let things = [{{n: 1, s: "x"}}]
assert { `${things}` == toString(things) }
assert { [["a"], ["b", "c"]].join(" ") == "[\"a\"] [\"b\", \"c\"]" }
