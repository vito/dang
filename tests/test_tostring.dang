# Tests for toString helper: a string is its own text; anything else is the
# Dang literal it would be written as, the same rendering List.join, string
# interpolation and print use.

# String input returns as-is
let str = "hello"
let result1 = toString(str)
assert { result1 == "hello" }

# Numbers and booleans are their literals
let num = 42
let result2 = toString(num)
assert { result2 == "42" }

let bool = true
let result3 = toString(bool)
assert { result3 == "true" }

# A list is a list literal, its strings quoted
let list = [1, 2, 3]
let result4 = toString(list)
assert { result4 == "[1, 2, 3]" }
assert { toString(["a", "b"]) == "[\"a\", \"b\"]" }

# A record is a record literal, fields as written
let obj = {{a: 1, b: "test"}}
let result5 = toString(obj)
assert { result5 == "{{a: 1, b: \"test\"}}" }

# A map is a map literal
assert { toString(["k": [1]]) == "[\"k\": [1]]" }

# Null is null
let result6 = toString(null)
assert { result6 == "null" }

# Enum values render as their bare name
enum Color { RED GREEN BLUE }
let result7 = toString(Color.RED)
assert { result7 == "RED" }

# Interpolation, join and toString agree
let things = [{{n: 1, s: "x"}}]
assert { `${things}` == toString(things) }
assert { [["a"], ["b", "c"]].join(" ") == "[\"a\"] [\"b\", \"c\"]" }
