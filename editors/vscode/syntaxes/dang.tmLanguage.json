{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dang",
  "scopeName": "source.dang",
  "patterns": [
    { "include": "#comment" },
    { "include": "#template-string" },
    { "include": "#triple-quote-string" },
    { "include": "#string" },
    { "include": "#triple-single-quote-string" },
    { "include": "#single-quote-string" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#null" },
    { "include": "#directive" },
    { "include": "#keyword-control" },
    { "include": "#keyword" },
    { "include": "#self" },
    { "include": "#type-name" },
    { "include": "#builtin-function" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.dang"
    },
    "triple-quote-string": {
      "begin": "(\"\"\")([A-Za-z][A-Za-z0-9_-]*$)?",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.dang" },
        "2": { "name": "entity.name.tag.dang" }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dang" }
      },
      "name": "string.quoted.triple.dang",
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#string-interpolation" }
      ]
    },
    "triple-single-quote-string": {
      "begin": "(''')([A-Za-z][A-Za-z0-9_-]*$)?",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.string.begin.dang" },
        "2": { "name": "entity.name.tag.dang" }
      },
      "end": "'''",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dang" }
      },
      "name": "string.quoted.triple.single.dang"
    },
    "single-quote-string": {
      "begin": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dang" }
      },
      "end": "'|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dang" }
      },
      "name": "string.quoted.single.dang"
    },
    "template-string": {
      "patterns": [
        {
          "begin": "(`{3,})([A-Za-z][A-Za-z0-9_-]*)?",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.string.begin.dang" },
            "2": { "name": "entity.name.tag.dang" }
          },
          "end": "\\1",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.dang" }
          },
          "name": "string.quoted.multi.backtick.dang",
          "patterns": [
            { "include": "#template-interpolation" }
          ]
        },
        {
          "begin": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.dang" }
          },
          "end": "`",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.dang" }
          },
          "name": "string.quoted.backtick.dang",
          "patterns": [
            { "include": "#template-interpolation" }
          ]
        }
      ]
    },
    "template-interpolation": {
      "begin": "(?<!\\\\)\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.dang" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.dang" }
      },
      "name": "meta.interpolation.dang",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "string-interpolation": {
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.section.interpolation.begin.dang" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.interpolation.end.dang" }
      },
      "name": "meta.interpolation.dang",
      "patterns": [
        { "include": "$self" }
      ]
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.dang" }
      },
      "end": "\"|$",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.dang" }
      },
      "name": "string.quoted.double.dang",
      "patterns": [
        { "include": "#string-escape" },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.dang"
        },
        { "include": "#string-interpolation" }
      ]
    },
    "string-escape": {
      "match": "\\\\([abfnrtv\"\\\\/$]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{3})",
      "name": "constant.character.escape.dang"
    },
    "number": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.dang"
    },
    "boolean": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.dang"
    },
    "null": {
      "match": "\\b(null)\\b",
      "name": "constant.language.null.dang"
    },
    "self": {
      "match": "\\b(self)\\b",
      "name": "variable.language.self.dang"
    },
    "directive": {
      "match": "@[a-zA-Z_][a-zA-Z0-9_]*",
      "name": "entity.name.function.macro.dang"
    },
    "keyword-control": {
      "match": "\\b(type|interface|union|implements|enum|scalar|if|else|break|continue|case|assert|directive|on|import|new|and|or|rescue|raise|return)\\b",
      "name": "keyword.control.dang"
    },
    "keyword": {
      "match": "\\b(let|pub)\\b",
      "name": "keyword.other.dang"
    },
    "type-name": {
      "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
      "name": "entity.name.type.dang"
    },
    "builtin-function": {
      "match": "\\b(print|loop)\\b",
      "name": "support.function.builtin.dang"
    },
    "operator": {
      "match": "(==|!=|<=|>=|<|>|\\+\\=|\\?\\?|=>|=|!|&)",
      "name": "keyword.operator.dang"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}()\\[\\]]",
          "name": "punctuation.bracket.dang"
        },
        {
          "match": "[,.;]",
          "name": "punctuation.delimiter.dang"
        },
        {
          "match": "[|]",
          "name": "punctuation.special.dang"
        }
      ]
    }
  }
}
