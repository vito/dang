"""
Tools for agents working on Dang.

A module of its own rather than part of `dang`: tool objects currently shadow
every artifact of the module that provides them, which would hide `dang`'s
checks and generators from the agent (vito/agents#38).

Each tool reads the workspace as it is when called rather than holding a Dang:
tool state survives reloads, so a stored Dang would keep testing a stale
snapshot of the source.
"""
type DangDev {
  # Bump `version` whenever this type's fields change: saved tool state from
  # an older shape is then discarded instead of failing to load.
  agent(llm: LLM!): LLM! @agent {
    llm.withTools(currentNode, version: 1)
  }

  """
  Update the golden test specimens under tests/testdata/, treating the
  current output as correct. Review the changeset before keeping it.
  """
  testUpdate(ws: Workspace!): Changeset! {
    dang(ws: ws).test.update
  }

  """
  Reformat every Dang source file with `dang fmt`, the same generator the
  fmt/stale check runs. An empty changeset means everything is formatted.
  """
  fmt(ws: Workspace!): Changeset! {
    dang(ws: ws).fmt
  }

  """
  Run a Dang script with a dang binary built from the current source,
  returning its combined stdout and stderr followed by its exit code. A
  failing script is not an error, so this works for probing type errors and
  runtime failures as well as output.
  """
  run(
    ws: Workspace!,
    """
    The Dang source to run.
    """
    script: String!,
  ): String! {
    dang(ws: ws)
      .base
      .withNewFile("/tmp/script.dang", script)
      .withExec(["sh", "-c", "dang /tmp/script.dang 2>&1; echo \"exit: $?\""])
      .stdout
  }
}
